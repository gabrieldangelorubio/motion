# El agente director de motion necesita la clave de la API de Claude (SECRETA):
# ANTHROPIC_API_KEY=sk-ant-…
# Modelo del agente (opcional; default claude-opus-5):
# MOTION_AGENTE_MODELO=claude-opus-5

# Tercer proveedor del director: OpenRouter (Kimi K3 y cualquier «proveedor/modelo»).
# La barra en el id elige el proveedor; la clave va acá:
# OPENROUTER_API_KEY=sk-or-…
# MOTION_AGENTE_MODELO=moonshotai/kimi-k3
